---
import Layout from '../layouts/Layout.astro';
import "../assets/theme.css";
---

<Layout>
  <div id="notes-island-root"></div>

  <script type="module" client:load>
    import { mountNotesIsland } from '../components/notesIslandClient.js';
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountNotesIsland);
    } else {
      mountNotesIsland();
    }
  </script>
</Layout>
